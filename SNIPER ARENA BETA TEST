-- Bot/NPC Caching (Runs asynchronously to prevent lag)
task.spawn(function()
    while task.wait(1.5) do
        local foundBots = {}
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("Model") and v ~= player.Character then
                local hum = v:FindFirstChildOfClass("Humanoid")
                local root = v:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 then
                    -- Verify it's not a real player
                    if not Players:GetPlayerFromCharacter(v) then
                        table.insert(foundBots, v)
                    end
                end
            end
        end
        activeBots = foundBots
    end
end)

-- Core Logic
local function checkVisibility(targetPart)
    if not targetPart then return false end
    local char = player.Character
    if not char then return false end
    
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char, camera}
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    
    local dir = (targetPart.Position - camera.CFrame.Position).Unit
    local dist = (targetPart.Position - camera.CFrame.Position).Magnitude
    
    local result = Workspace:Raycast(camera.CFrame.Position, dir * dist, params)
    
    if not result or (result.Instance and result.Instance:IsDescendantOf(targetPart.Parent)) then
        return true
    end
    return false
end

local function getBestPart(char)
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    
    if torso and checkVisibility(torso) then
        return torso
    elseif head and checkVisibility(head) then
        return head 
    end
    
    return nil
end

local function getClosestTarget()
    local closestDist = Settings.FOVSize
    local bestTargetPart = nil
    
    -- Custom FOV Center based on user's slider values
    local fovCenter = Vector2.new((camera.ViewportSize.X / 2) + Settings.FOVOffsetX, (camera.ViewportSize.Y / 2) + Settings.FOVOffsetY)
    
    local function evaluateCharacter(char)
        local targetPart = getBestPart(char)
        if targetPart then
            local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
            if onScreen then
                local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - fovCenter).Magnitude
                if dist2D <= Settings.FOVSize and dist2D < closestDist then
                    closestDist = dist2D
                    bestTargetPart = targetPart
                end
            end
        end
    end

    -- 1. Check Real Players
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild("Humanoid") then
            if v.Character.Humanoid.Health > 0 then
                if Settings.TeamCheck and v.Team == player.Team then continue end
                evaluateCharacter(v.Character)
            end
        end
    end
    
    -- 2. Check NPCs/Bots
    for _, botChar in pairs(activeBots) do
        if botChar and botChar:FindFirstChild("Humanoid") and botChar.Humanoid.Health > 0 then
            evaluateCharacter(botChar)
        end
    end

    return bestTargetPart
end

RunService.RenderStepped:Connect(function()
    rgbGradient.Rotation = (rgbGradient.Rotation + 2) % 360
    
    if Settings.ShowFOV then
        fovCircle.Position = UDim2.new(0, (camera.ViewportSize.X / 2) + Settings.FOVOffsetX, 0, (camera.ViewportSize.Y / 2) + Settings.FOVOffsetY)
    end
    
    if Settings.Aimbot and aiming then
        if not currentTarget or not currentTarget.Parent or currentTarget.Parent.Humanoid.Health <= 0 or not checkVisibility(currentTarget) then
            currentTarget = getClosestTarget()
        end
        
        if currentTarget then
            camera.CFrame = CFrame.new(camera.CFrame.Position, currentTarget.Position)
        end
    else
        currentTarget = nil
    end
    
    if Settings.ESP then
        local entitiesToRender = {}

        -- Draw Player ESP
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character.Humanoid.Health > 0 then
                if Settings.TeamCheck and v.Team == player.Team then continue end
                
                local char = v.Character
                entitiesToRender[char] = true
                
                if not ESP_Objects[char] then
                    local highlight = Instance.new("Highlight")
                    highlight.Parent = CoreGui
                    highlight.Adornee = char
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    ESP_Objects[char] = highlight
                end
                
                local highlight = ESP_Objects[char]
                if getBestPart(char) then
                    highlight.FillColor = Color3.fromRGB(255, 0, 0) 
                    highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                else
                    highlight.FillColor = Color3.fromRGB(0, 255, 0) 
                    highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
                end
            end
        end

        -- Draw Bot ESP (Blue)
        for _, botChar in pairs(activeBots) do
            if botChar and botChar.Parent and botChar:FindFirstChild("HumanoidRootPart") and botChar:FindFirstChildOfClass("Humanoid") and botChar.Humanoid.Health > 0 then
                entitiesToRender[botChar] = true
                
                if not ESP_Objects[botChar] then
                    local highlight = Instance.new("Highlight")
                    highlight.Parent = CoreGui
                    highlight.Adornee = botChar
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    highlight.FillColor = iosBlue
                    highlight.OutlineColor = iosBlue
                    ESP_Objects[botChar] = highlight
                end
            end
        end

        -- Clean up dead characters or bots that despawned
        for char, highlight in pairs(ESP_Objects) do
            if not entitiesToRender[char] then
                highlight:Destroy()
                ESP_Objects[char] = nil
            end
        end
    end
end)
