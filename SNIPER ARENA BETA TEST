local triggerDragging = false
local triggerDragInput = nil
local triggerDragStart = nil
local triggerStartPos = nil
local aimInputObject = nil

local function isInside(pos, guiObj)
    local tl = guiObj.AbsolutePosition
    local br = tl + guiObj.AbsoluteSize
    return pos.X >= tl.X and pos.X <= br.X and pos.Y >= tl.Y and pos.Y <= br.Y
end

UIS.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.LeftShift then 
        aiming = true 
        return 
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if isInside(input.Position, aimTrigger) then
            aiming = true 
            aimInputObject = input
            
            if not Settings.AimBtnLocked and not triggerDragging then
                triggerDragging = true
                triggerDragInput = input 
                triggerDragStart = input.Position
                triggerStartPos = aimTrigger.Position
            end
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.LeftShift then
        aiming = false
        currentTarget = nil
    end
    
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if input == aimInputObject then
            aiming = false
            currentTarget = nil
            aimInputObject = nil
            
            if input == triggerDragInput then
                triggerDragging = false
                triggerDragInput = nil
            end
        end
    end
end)

UIS.InputChanged:Connect(function(input)
    if triggerDragging and input == triggerDragInput and not Settings.AimBtnLocked then
        local delta = input.Position - triggerDragStart
        aimTrigger.Position = UDim2.new(triggerStartPos.X.Scale, triggerStartPos.X.Offset + delta.X, triggerStartPos.Y.Scale, triggerStartPos.Y.Offset + delta.Y)
    end
end)

